{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellink",
  "version": "0.1.0",
  "identifier": "com.vellink.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vellink",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Vellink",
    "copyright": "Copyright © 2026 Vellink",
    "category": "Productivity",
    "shortDescription": "A Markdown editor for writers",
    "longDescription": "A distraction-free Markdown editor with a unified document IR, dual views and a plugin runtime. Documents are plain .md files in a folder you own.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bepersevering/vellink/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5RkU0QThBNjdDOTVFMUYKUldRZlhzbG5pa3IreWVmZ3dEYU9WYlJuUk1QcG9qNkNKa210cjM3aDBFS2U2QW51eGk2cTZTdVYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
