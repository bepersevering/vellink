{
  "id": "webdav",
  "name": "WebDAV Cloud Sync",
  "version": "0.1.0",
  "description": "Sync documents to any WebDAV server; edit locally while offline, merge automatically when online, and keep a copy on conflicts.",
  "author": "Vellink",
  "license": "MIT",
  "entry": "index.ts",
  "engines": { "vellink": "^0.1.0" },
  "activationEvents": ["onStartup"],
  "permissions": ["storage", "credentials", "network", "documents:read"],
  "contributes": {
    "commands": [
      { "command": "webdav.configure", "title": "WebDAV · Configure Connection" },
      { "command": "webdav.sync", "title": "WebDAV · Sync Now" }
    ],
    "providers": [{ "kind": "vfs", "id": "webdav.provider" }]
  }
}
