{
  "id": "webdav",
  "name": "WebDAV 云同步",
  "version": "0.1.0",
  "description": "把文档同步到任意 WebDAV 服务；断网本地编辑，联网自动合并，冲突保留副本。",
  "author": "Vellink",
  "license": "MIT",
  "entry": "index.ts",
  "engines": { "vellink": "^0.1.0" },
  "activationEvents": ["onStartup"],
  "permissions": ["storage", "credentials", "network", "documents:read"],
  "contributes": {
    "commands": [
      { "command": "webdav.configure", "title": "WebDAV · 配置连接" },
      { "command": "webdav.sync", "title": "WebDAV · 立即同步" }
    ],
    "providers": [{ "kind": "vfs", "id": "webdav.provider" }]
  }
}
