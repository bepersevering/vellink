{
  "id": "ai-chat",
  "name": "AI 知识库问答",
  "version": "0.1.0",
  "description": "按标题语义切块建立本地索引，提问时召回相关段落并调用 OpenAI 兼容模型，回答可写回文档。",
  "author": "Vellink",
  "license": "MIT",
  "entry": "index.ts",
  "engines": { "vellink": "^0.1.0" },
  "activationEvents": ["onStartup"],
  "permissions": ["storage", "credentials", "network", "ai", "documents:read", "documents:write"],
  "contributes": {
    "commands": [
      { "command": "ai-chat.configure", "title": "AI · 配置模型与 Key" },
      { "command": "ai-chat.reindex", "title": "AI · 重建文档索引" }
    ],
    "providers": [{ "kind": "ai", "id": "ai-chat.provider" }]
  }
}
